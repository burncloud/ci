{
  "name": "ci-tags-create",
  "target": "tag",
  "enforcement": "disabled",
  "bypass_actors": [
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "always"
    }
  ],
  "conditions": {
    "ref_name": {
      "include": [
        "refs/tags/v*"
      ],
      "exclude": [
        "refs/tags/latest"
      ]
    }
  },
  "rules": [
    {
      "type": "creation"
    }
  ]
}
